 "reviewed": {
  "_sitebuiltins -> _pyrepl.pager": "help()'s and license()'s pager; those builtins exist only where site ran, and python314._pth leaves `import site` off",
  "_sitebuiltins -> pydoc": "help(), which only site installs; python314._pth leaves `import site` off",
  "site -> _pyrepl": "site.register_readline, the interactive prompt's; site is not run (python314._pth) and nothing shipped imports it",
  "site -> rlcompleter": "site.register_readline, as above",
  "_py_warnings -> tracemalloc": "inside try/except Exception: a ResourceWarning's source line, and it says less without it",
  "base64 -> getopt": "base64.main, the module's command line; only `python -m base64` runs it",
  "quopri -> getopt": "quopri.main, the module's command line; only `python -m quopri` runs it",
  "encodings.bz2_codec -> bz2": "only the codec named 'bz2' loads this module; Windows code pages never are, and nothing shipped names it",
  "heapq -> doctest": "inside `if __name__ == '__main__'`",
  "logging.config -> configparser": "logging.config.fileConfig; nothing shipped imports logging.config",
  "logging.config -> multiprocessing.queues": "logging.config._is_queue_like_object; nothing shipped imports logging.config",
  "pickle -> pprint": "pickle._main, the module's command line",
  "platform -> _ios_support": "platform.ios_ver, for iOS; nothing shipped imports platform (test_no_console_windows bans it) and uuid imports it on no Windows",
  "platform -> _wmi": "guarded by try/except ImportError, and nothing shipped imports platform (test_no_console_windows bans it): uuid, its one importer here, does not on Windows",
  "platform -> plistlib": "guarded, and macOS only",
  "shutil -> bz2": "guarded by try/except ImportError: bzip2 archives are simply not offered",
  "shutil -> compression.zstd": "guarded by try/except ImportError: zstd archives are simply not offered",
  "shutil -> lzma": "guarded by try/except ImportError: xz archives are simply not offered",
  "shutil -> tarfile": "shutil.make_archive and unpack_archive for tar formats; nothing shipped calls either",
  "sqlite3.__main__ -> code": "the `python -m sqlite3` shell",
  "sysconfig -> _aix_support": "sysconfig.get_platform on AIX only",
  "sysconfig -> _osx_support": "sysconfig on macOS only",
  "urllib.request -> ftplib": "an ftp:// address only; courier/http.py, the one caller of urllib.request, refuses every scheme but https before it opens anything (courier/address.py, checked_url)",
  "xml.sax.expatreader -> xml.parsers": "guarded by try/except ImportError, and only xml.sax.make_parser loads this module; the product uses xml.sax.saxutils.escape alone",
  "zipfile -> bz2": "guarded by try/except ImportError: a bzip2 member is refused, and the product packs no archive",
  "zipfile -> compression.zstd": "guarded by try/except ImportError, as above",
  "zipfile -> lzma": "guarded by try/except ImportError, as above",
  "zipfile -> py_compile": "zipfile.PyZipFile only; nothing shipped uses it",
  "zoneinfo -> _zoneinfo": "guarded by try/except ImportError: zoneinfo falls back on its pure-Python copy, and nothing shipped imports zoneinfo"
 }
}
