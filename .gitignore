# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Generated, per-machine runtime state and logs are never source.
config/
logs/*
!logs/.gitkeep

# Scratch work from other local sessions; never part of the published tool.
comparison/
COMPARISON_PROGRESS.md

# Release build products: the runtime download, staging and dist are all regenerable.
build/cache/
build/stage/
build/dist/


# Local Codex configuration for this working copy. It names a server by a path that
# only resolves inside the installed plugin, so committing it would make a clone try
# to start something that is not there.
.codex/

# Both small executables are compiled from gui/ by build/make_gui.ps1. A compiled
# binary is not source, and the release build makes them from scratch.
build/*.exe

# Written by scripts/ko_sync.py into whatever tree it is pointed at. On the generated
# `ko` branch the workflow force-adds it; anywhere else it is the residue of a local
# run, and committing it would tell the test suite that main is a generated branch.
.github/GENERATED-BRANCH.md
