{
  "tool": "update_settings",
  "cases": [
    {
      "case": "one setting changed",
      "arguments": {
        "notifications": false
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "Updated notifications."
            }
          ],
          "structuredContent": {
            "settings": {
              "max_recovery_attempts": 4,
              "max_no_progress": 3,
              "max_chain_continuations": 6,
              "retry_timing": "normal",
              "detection_lookback_hours": 6.0,
              "notifications": false,
              "show_tray": true,
              "notification_card": true,
              "start_with_codex": false,
              "theme": "light",
              "panel_theme": "same",
              "reduce_motion": false,
              "codex_exe": null,
              "recover_usage_limit": true,
              "recover_network_transient": true,
              "recover_timeout": true,
              "recover_rate_limit_transient": true,
              "recover_server_5xx": true,
              "recover_stream_interrupted": true,
              "recover_auth_service_transient": true,
              "notify_interruption": true,
              "notify_starting": true,
              "notify_result": true,
              "notify_stopped": true,
              "interface_language": "system",
              "continuation_language": "follow",
              "continuation_style": "standard",
              "custom_message_mode": "global",
              "custom_message": null,
              "custom_message_usage_limit": null,
              "custom_message_rate_limit_transient": null,
              "custom_message_network_transient": null,
              "custom_message_timeout": null,
              "custom_message_server_5xx": null,
              "custom_message_stream_interrupted": null,
              "custom_message_auth_service_transient": null
            }
          }
        }
      }
    },
    {
      "case": "Custom text is not writable from Codex",
      "arguments": {
        "custom_message": "중단된 작업을 이어서 진행해 주세요."
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "isError": true,
          "content": [
            {
              "type": "text",
              "text": "unrecognized tool arguments"
            }
          ],
          "structuredContent": {
            "error_code": "request_failed"
          }
        }
      }
    },
    {
      "case": "nor a reason's own Custom text",
      "arguments": {
        "custom_message_usage_limit": "중단된 작업을 이어서 진행해 주세요."
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "isError": true,
          "content": [
            {
              "type": "text",
              "text": "unrecognized tool arguments"
            }
          ],
          "structuredContent": {
            "error_code": "request_failed"
          }
        }
      }
    },
    {
      "case": "the engine's location is not offered",
      "arguments": {
        "codex_exe": "C:\\elsewhere\\codex.exe"
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "isError": true,
          "content": [
            {
              "type": "text",
              "text": "unrecognized tool arguments"
            }
          ],
          "structuredContent": {
            "error_code": "request_failed"
          }
