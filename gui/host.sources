# The watcher host's compile list (v0.6.27, P6-DESIGN 1.7): CodexAutoResume.exe, the C# host that loads car_core.dll.
# One repository-relative path per line, in the order csc is given them, under [group] lines, as gui/window.sources is
# written; `tests/guiscan.py` reads it. None of these files is part of the settings window, and the window's own list
# names none of them.
#
#   [host]       the host's Main, the DLL load, the pump and the contracts with the core (S6.2b writes it, above
#                [surface]; until then gui/HostCore.cs and gui/ISurfaces.cs are compiled alone by
#                tests/test_host_contract.py)
#   [surface]    the surfaces the host draws - the popup, the icon's menu, the tip card, the notification cards, the
#                icon and their motion (S6.3, the one designer): src/codex_auto_resume/ui/popup, ui/tray, ui/card,
#                tray_place.py and notice_card.py's drawing half, ported call for call (P6-DESIGN 2.3, Q1, Q8)
#   [shape]      (P6-DESIGN 1.7: gui/SoftShape.cs, the one corner outline) is not here yet: SoftShape.cs reads the
#                window's Palette and Design (Shape.Smoothing), so it does not compile without the window. The
#                surfaces take the corner from brand/shape.py's port until the main session settles that seam.
#   [generated]  the palette, written by build/make_brand.py
#
# The surfaces read and write their JSON with gui/SurfaceJson.cs: the window's `Json` (gui/WindowJson.cs), copied
# byte for byte because the window's file needs Windows Forms (tests/test_surface_parity.py holds the two equal).

[surface]
gui/SurfaceJson.cs
gui/SurfaceNative.cs
gui/PopupWords.cs
gui/SurfaceFonts.cs
gui/PopupLayout.cs
gui/PopupPlace.cs
gui/MenuPlan.cs
gui/TipPlan.cs
gui/SurfaceRender.cs

[generated]
gui/Brand.cs
